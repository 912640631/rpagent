{
  "name": "ai-gm-rpg-engine",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "CombatEngine",
    "NarrativeDice",
    "RpgAgent",
    "Frontend"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "rpg": "npm run build && node RpgAgent/dist/src/cli.js",
    "test": "npm run build && npm run test --workspaces --if-present && node --test tests/*.test.cjs",
    "web": "npm run build && node RpgAgent/dist/src/web/server.js"
  }
}
