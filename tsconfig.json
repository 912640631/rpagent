{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "erasableSyntaxOnly": true,
    "noEmit": true
  },
  "include": [
    "cli.ts",
    "tests/*.ts"
  ]
}
